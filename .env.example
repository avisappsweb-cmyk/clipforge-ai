# ── CLIPFORGE AI environment ─────────────────────────────
# Copy to .env (or export in your deployment environment).

# REQUIRED in production. Secret for JWT signing and signed media URLs.
# Generate: openssl rand -hex 48
CLIPFORGE_SECRET=

# Server binding
HOST=127.0.0.1
PORT=8787
# Public base URL used when generating absolute links (optional)
# PUBLIC_URL=https://clipforge.example.com
# Browser origins allowed to call the API (comma-separated). Empty = same-origin.
CORS_ORIGINS=

# Storage (defaults to ./server/data)
# DATA_DIR=/var/lib/clipforge
# MEDIA_DIR=/var/lib/clipforge/media

# Bootstrap administrator (created on first server start if not present)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Platform limits (also configurable at runtime from the admin console)
MAX_UPLOAD_MB=2048
MAX_DURATION_SEC=7200
MAX_CLIPS_PER_VIDEO=12
MAX_CONCURRENT_JOBS=1
DEFAULT_CLIPS_PER_VIDEO=5

# AI / ASR providers — modular; keys stay on the server.
# local-vosk: offline, English, word timestamps (run `npm run setup:models`)
# openai:     OPENAI_API_KEY, Whisper API
# deepgram:   DEEPGRAM_API_KEY, nova-2 with speaker diarization
ASR_PROVIDER=local-vosk
# VOSK_MODEL_DIR=/path/to/vosk-model-small-en-us-0.15
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=

# Media retention (days) for cleanup tooling
MEDIA_RETENTION_DAYS=30

# Optional overrides (binaries ship with npm packages)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# PYTHON_BIN=/usr/bin/python3

# ── Import adapter authorizations (inactive unless set) ──
# Importing from external platforms requires their OFFICIAL APIs and the
# creator's authorization. CLIPFORGE never bypasses platform restrictions,
# authentication, DRM or access controls.
# YOUTUBE_API_KEY=
# INSTAGRAM_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=
# X_API_BEARER_TOKEN=
# FACEBOOK_ACCESS_TOKEN=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
